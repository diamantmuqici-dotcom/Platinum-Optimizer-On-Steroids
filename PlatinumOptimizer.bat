<# : Platinum Optimizer On Steroids - single-file release (batch view)
@echo off
setlocal EnableExtensions
title Platinum Optimizer - Platinum On Steroids
where powershell.exe >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Windows PowerShell 5.1 is required to run Platinum Optimizer.
    pause
    exit /b 3
)
rem Single-file release: the batch section below launches Windows PowerShell,
rem which reads this file, expands the embedded application into the local
rem PlatinumOptimizer runtime folder, and runs it. Nothing is downloaded.
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -STA -Command "$env:PO_SELF='%~f0'; $env:PO_ARGS='%*'; $raw=[System.IO.File]::ReadAllText('%~f0',[System.Text.Encoding]::UTF8); $marker='#>'+'PO_PAYLOAD'; $index=$raw.IndexOf($marker); if ($index -lt 0) { Write-Host 'Embedded payload marker missing from this file.'; exit 9 }; $payload=$raw.Substring($index+$marker.Length); & ([scriptblock]::Create($payload)); exit $LASTEXITCODE"
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" (
    echo.
    echo Platinum Optimizer exited with code %RESULT%.
    pause
)
exit /b %RESULT%
#>PO_PAYLOAD

# Platinum Optimizer On Steroids - embedded application payload.
# Generated by tools/build_single_file.py - do not edit by hand.
# All files below are byte-exact base64 copies of the repository sources.
$ErrorActionPreference = 'Stop'

$script:POBuildId = '78d0329ab2dd3f9a'
$script:POLocalRoot = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'PlatinumOptimizer'
$script:PORuntimeDir = Join-Path (Join-Path $script:POLocalRoot 'runtime') $script:POBuildId
$script:POCompleteMarker = Join-Path $script:PORuntimeDir '.complete'

function Expand-POEmbeddedFile {
    param([Parameter(Mandatory = $true)][string]$RelativePath, [Parameter(Mandatory = $true)][string]$EncodedContent)
    $target = Join-Path $script:PORuntimeDir $RelativePath
    $parent = Split-Path -Parent $target
    if (-not (Test-Path -LiteralPath $parent)) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }
    [System.IO.File]::WriteAllBytes($target, [Convert]::FromBase64String($EncodedContent))
}

if (-not (Test-Path -LiteralPath $script:POCompleteMarker -PathType Leaf)) {
    if (Test-Path -LiteralPath $script:PORuntimeDir) { Remove-Item -LiteralPath $script:PORuntimeDir -Recurse -Force }
    New-Item -ItemType Directory -Path $script:PORuntimeDir -Force | Out-Null
    Expand-POEmbeddedFile -RelativePath 'src\PlatinumOptimizer.ps1' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\core\PlatinumOptimizer.Core.psm1' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\core\PlatinumOptimizer.Power.psm1' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\core\PlatinumOptimizer.Audio.psm1' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\core\PlatinumOptimizer.Display.psm1' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\data\profiles.json' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\data\tweaks.json' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\data\games.json' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\data\services.json' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\data\power-settings.json' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\data\audio-presets.json' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\data\display-profiles.json' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'src\ui\MainWindow.xaml' -EncodedContent ''
    Expand-POEmbeddedFile -RelativePath 'tests\Run-Tests.ps1' -EncodedContent ''
    Set-Content -LiteralPath $script:POCompleteMarker -Value $script:POBuildId -Encoding UTF8
}

$script:POEnginePath = Join-Path $script:PORuntimeDir 'src\PlatinumOptimizer.ps1'
if (-not (Test-Path -LiteralPath $script:POEnginePath -PathType Leaf)) {
    Write-Host 'The embedded engine could not be expanded; delete the runtime folder and retry:' -ForegroundColor Red
    Write-Host ("  " + $script:PORuntimeDir) -ForegroundColor Red
    exit 8
}
$script:POArgTokens = @(($env:PO_ARGS -split '\s+') | Where-Object { $_ })
if ($script:POArgTokens -contains '-Scan') { & $script:POEnginePath -Scan; exit $LASTEXITCODE }
if ($script:POArgTokens -contains '-SelfTest') { & (Join-Path $script:PORuntimeDir 'tests\Run-Tests.ps1'); exit $LASTEXITCODE }
& $script:POEnginePath
exit $LASTEXITCODE
